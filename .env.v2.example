# Copy to .env.v2.local for LOCAL SYNTHETIC DATA ONLY.
# Generate two independent random secrets of at least 32 characters.
V2_LOCAL_ORIGIN=http://127.0.0.1:3020
OAUTH_CLIENT_ID=liferpg-v2-local
OAUTH_CLIENT_SECRET=replace-with-independent-random-client-secret
OWNER_LOGIN_KEY=replace-with-independent-random-owner-secret
OAUTH_REDIRECT_URIS=http://localhost:3021/callback
# No DATABASE_URL or OPENAI_API_KEY is required or used by dev:v2.
