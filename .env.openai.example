# Copy to .env.openai.local (gitignored). The dry run never opens a DB or sends an API request.
# Set the key yourself in that local file or the server process environment; never commit it.
OPENAI_API_KEY=
GM_MODEL=gpt-6.1-sol
GM_REASONING_EFFORT=medium
GM_MAX_INPUT_TOKENS=16384
GM_MAX_OUTPUT_TOKENS=2048
# USD micro-units: 150000 = $0.15. Consumed and unknown charges survive restarts.
GM_LIFETIME_BUDGET_MICRO_USD=150000
GM_DAILY_BUDGET_MICRO_USD=150000
GM_MONTHLY_BUDGET_MICRO_USD=150000
# Do not enable without separate approval for a paid synthetic test.
LIFERPG_ALLOW_PAID_SYNTHETIC=
# Required when changing GM_MODEL: rates are integer 0.1 micro-USD per token.
# GM_PRICE_CARD_JSON={"id":"verified-rate-card-id","input":20,"cached":1,"cache_write":25,"output":100}
