# Never commit .env.local. Use a dedicated experiment database only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/liferpg_experiment?sslmode=verify-full
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/liferpg_experiment?sslmode=verify-full
PUBLIC_BASE_URL=http://localhost:3000
OAUTH_CLIENT_ID=liferpg-chatgpt
# Generate independent random secrets, each at least 32 characters.
OAUTH_CLIENT_SECRET=
OWNER_LOGIN_KEY=
# Copy the EXACT callback URL shown by ChatGPT. Comma-separated exact URIs.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Synthetic experiments only; the server does not call any LLM API.
# Synthetic character initialization is disabled by default. Enable only for isolated tests, not production.
# ALLOW_SYNTHETIC_GAME=true
# Optional during an approved transition; project Firewall must also block old deployments.
# MAINTENANCE_WRITES=true

# Phase 4: private website only. These do not change MCP OAuth.
# Optional custom website origin. PUBLIC_BASE_URL remains the MCP issuer/resource.
# WEB_PUBLIC_BASE_URL=https://liferpg.spiritflag.work
# Use a Clerk development application for local authentication checks.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_OWNER_USER_ID=
# Optional PEM public key for networkless JWT verification.
# CLERK_JWT_KEY=
