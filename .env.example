# Never commit .env.local. Use a dedicated experiment database only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/liferpg_experiment?sslmode=verify-full
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/liferpg_experiment?sslmode=verify-full
PUBLIC_BASE_URL=http://localhost:3000
OAUTH_CLIENT_ID=liferpg-chatgpt
# Generate independent random secrets, each at least 32 characters.
OAUTH_CLIENT_SECRET=
OWNER_LOGIN_KEY=
# Copy the EXACT callback URL shown by ChatGPT. Comma-separated exact URIs.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Synthetic experiments only; the server does not call any LLM API.
